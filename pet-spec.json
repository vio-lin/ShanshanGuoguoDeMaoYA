{
  "schemaVersion": 5,
  "app": {
    "name": "布偶猫桌宠",
    "appId": "com.doubao.ragdollpet",
    "version": "1.0.0",
    "language": "zh-CN"
  },
  "targets": {
    "windows": {
      "enabled": false,
      "arch": "x64"
    },
    "macos": {
      "enabled": true,
      "arch": "current"
    }
  },
  "character": {
    "inputType": "single-image",
    "coreAsset": "core-ip/core-ip.png",
    "displayName": "布偶",
    "archetype": "cat",
    "personality": [
      "优雅",
      "慵懒",
      "高冷",
      "粘人"
    ],
    "preserveTraits": [
      "钴蓝色大圆眼",
      "粉色小鼻子",
      "白色口鼻面罩和下巴",
      "深棕褐色耳尖和面部门罩",
      "蓬松白色胸毛",
      "白色四只手套前爪",
      "浅棕褐色身体后半段长毛",
      "耳尖微翘的耳位"
    ],
    "style": "balanced-cartoon",
    "mirrorSafe": true
  },
  "assetPipeline": {
    "backgroundMode": "semantic-cutout",
    "segmentationBackend": "apple-vision",
    "subjectKind": "photo",
    "generationBackground": "transparent-grid",
    "backgroundTolerance": 24,
    "edgeFeather": 8,
    "safeMargin": 32,
    "targetOccupancy": 0.75
  },
  "experience": {
    "theme": {
      "primary": "#8B6F47",
      "accent": "#D4A574",
      "background": "#F5EDE0",
      "surface": "#FFFFFF",
      "text": "#3D2E1F",
      "muted": "#A89078",
      "cornerRadius": 20
    },
    "petSizing": {
      "baseWindowPx": 220,
      "defaultScale": 0.8
    },
    "interactions": [
      {
        "id": "walk",
        "emoji": "🚶",
        "label": "散步去",
        "stateId": "walk",
        "durationMs": 4000,
        "affectionGain": 3,
        "feedback": [
          "遛弯去咯~",
          "这边风景不错喵",
          "散步使猫快乐"
        ]
      },
      {
        "id": "jump",
        "emoji": "🦘",
        "label": "蹦高高",
        "stateId": "jump",
        "durationMs": 2500,
        "affectionGain": 5,
        "feedback": [
          "跳高高！",
          "看我跳得多远",
          "一蹦三尺高喵"
        ]
      },
      {
        "id": "stalk",
        "emoji": "🐾",
        "label": "悄悄走",
        "stateId": "stalk",
        "durationMs": 5000,
        "affectionGain": 2,
        "feedback": [
          "悄悄靠近...",
          "潜行模式开启",
          "不要被发现了喵"
        ]
      },
      {
        "id": "bury",
        "emoji": "💩",
        "label": "埋粑粑",
        "stateId": "bury",
        "durationMs": 1800,
        "affectionGain": 1,
        "feedback": [
          "扒拉扒拉~",
          "埋好埋好",
          "本喵很爱干净"
        ]
      }
    ]
  },
  "motion": {
    "breathing": {
      "enabled": true,
      "periodMs": 3500,
      "scaleX": 0.01,
      "scaleY": 0.02
    },
    "squashStretch": {
      "enabled": true,
      "durationMs": 280,
      "intensity": 0.08
    },
    "idleIntervalMs": {
      "min": 6000,
      "max": 15000
    }
  },
  "features": {
    "transparentWindow": true,
    "drag": true,
    "tray": true,
    "edgeSnap": true,
    "reminders": true,
    "interactions": true,
    "relationship": true,
    "filePocket": false,
    "dashboard": true,
    "typingReaction": false,
    "autonomousMovement": false
  },
  "states": [
    {
      "id": "idle",
      "triggers": [
        "app:start",
        "ambient:idle"
      ],
      "frames": [
        "idle/01.png",
        "idle/02.png",
        "idle/03.png",
        "idle/04.png",
        "idle/05.png"
      ],
      "frameDurationMs": 450,
      "loop": true,
      "priority": 10,
      "interrupt": "resume",
      "cooldownMs": 0,
      "direction": "neutral",
      "anchor": {
        "x": 0.5,
        "y": 0.95
      },
      "mirrorSafe": true
    },
    {
      "id": "blink",
      "triggers": [
        "ambient:blink"
      ],
      "frames": [
